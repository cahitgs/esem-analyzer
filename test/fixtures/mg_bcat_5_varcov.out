  PARAMETERIZATION = THETA;
  ROTATION=TARGET(ORTHOGONAL);
  ITERATIONS = 100000;
  DIFFTEST = BifactorInv_diff_strict.dat;
  MODEL:
  G BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1 sos2_t1
    sos3_t1 sos4_t1 (*1);
  F1 BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1~0 psi2_t1~0 psi3_t1~0 psi4_t1~0
