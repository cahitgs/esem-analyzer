TITLE:
Longitudinal invariance (CFA) - Latent means
DATA:
FILE = "Ch27-Data2.dat";
VARIABLE:
NAMES ARE x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1 z4_t1
  x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2;
USEVARIABLES ARE x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1
  z4_t1 x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2;
ANALYSIS:
ESTIMATOR IS MLR;
MODEL:
F1 BY x1_t1* (L1_1);
F1 BY x2_t1 (L1_2);
F1 BY x3_t1 (L1_3);
F1 BY x4_t1 (L1_4);
F2 BY y1_t1* (L2_1);
F2 BY y2_t1 (L2_2);
F2 BY y3_t1 (L2_3);
F2 BY y4_t1 (L2_4);
F3 BY z1_t1* (L3_1);
F3 BY z2_t1 (L3_2);
F3 BY z3_t1 (L3_3);
F3 BY z4_t1 (L3_4);
F4 BY x1_t2* (L1_1);
F4 BY x2_t2 (L1_2);
F4 BY x3_t2 (L1_3);
F4 BY x4_t2 (L1_4);
F5 BY y1_t2* (L2_1);
F5 BY y2_t2 (L2_2);
F5 BY y3_t2 (L2_3);
F5 BY y4_t2 (L2_4);
F6 BY z1_t2* (L3_1);
F6 BY z2_t2 (L3_2);
F6 BY z3_t2 (L3_3);
F6 BY z4_t2 (L3_4);
F1-F3@1;
F4-F6@1;
x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1 z4_t1 (u1-u12);
x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2 (u1-u12);
F1 WITH F2 (lcov1);
F4 WITH F5 (lcov1);
F1 WITH F3 (lcov2);
F4 WITH F6 (lcov2);
F2 WITH F3 (lcov3);
F5 WITH F6 (lcov3);
[x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1 z4_t1] (i1-i12);
[x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2] (i1-i12);
[F1-F3@0];
[F4-F6@0];
x1_t1 WITH x1_t2;
x2_t1 WITH x2_t2;
x3_t1 WITH x3_t2;
x4_t1 WITH x4_t2;
y1_t1 WITH y1_t2;
y2_t1 WITH y2_t2;
y3_t1 WITH y3_t2;
y4_t1 WITH y4_t2;
z1_t1 WITH z1_t2;
z2_t1 WITH z2_t2;
