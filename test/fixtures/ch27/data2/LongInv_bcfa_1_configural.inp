TITLE:
Longitudinal invariance (bifactor-CFA) - Configural
DATA:
FILE = "Ch27-Data2.dat";
VARIABLE:
NAMES ARE x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1 z4_t1
  x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2;
USEVARIABLES ARE x1_t1 x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1
  z4_t1 x1_t2 x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2;
ANALYSIS:
ESTIMATOR IS MLR;
ITERATIONS = 10000;
MODEL:
G1 BY x1_t1* x2_t1 x3_t1 x4_t1 y1_t1 y2_t1 y3_t1 y4_t1 z1_t1 z2_t1 z3_t1 z4_t1;
F1 BY x1_t1* x2_t1 x3_t1 x4_t1;
F2 BY y1_t1* y2_t1 y3_t1 y4_t1;
F3 BY z1_t1* z2_t1 z3_t1 z4_t1;
G2 BY x1_t2* x2_t2 x3_t2 x4_t2 y1_t2 y2_t2 y3_t2 y4_t2 z1_t2 z2_t2 z3_t2 z4_t2;
F4 BY x1_t2* x2_t2 x3_t2 x4_t2;
F5 BY y1_t2* y2_t2 y3_t2 y4_t2;
F6 BY z1_t2* z2_t2 z3_t2 z4_t2;
G1@1;
F1-F3@1;
G2@1;
F4-F6@1;
G1 WITH F1@0 F2@0 F3@0;
F1 WITH F2@0 F3@0;
F2 WITH F3@0;
G2 WITH F4@0 F5@0 F6@0;
F4 WITH F5@0 F6@0;
F5 WITH F6@0;
x1_t1 WITH x1_t2;
x2_t1 WITH x2_t2;
x3_t1 WITH x3_t2;
x4_t1 WITH x4_t2;
y1_t1 WITH y1_t2;
y2_t1 WITH y2_t2;
y3_t1 WITH y3_t2;
y4_t1 WITH y4_t2;
z1_t1 WITH z1_t2;
z2_t1 WITH z2_t2;
z3_t1 WITH z3_t2;
z4_t1 WITH z4_t2;
OUTPUT:
SAMPSTAT STANDARDIZED MODINDICES CINTERVAL RESIDUAL SVALUES TECH1 TECH3 TECH4;
