  F1 WITH F2@0 F3@0;
  F2 WITH F3@0;
  G@1; F1-F3@1;
  [G@0]; [F1-F3@0];
  [m1 m2 m3 m4 m5 m6 m7 m8 m9 m10 m11 m12] (i1-i12);
  m1 m2 m3 m4 m5 m6 m7 m8 m9 m10 m11 m12;
  MODEL g2:
  G*; F1*; F2*; F3*;
  [G*]; [F1*]; [F2*]; [F3*];
  [m1 m2 m3 m4 m5 m6 m7 m8 m9 m10 m11 m12] (i1-i12);
  m1 m2 m3 m4 m5 m6 m7 m8 m9 m10 m11 m12;
