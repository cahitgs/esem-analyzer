  F3 BY X1~0 X2~0 X3~0 X4~0 Y1~0 Y2~0 Y3~0 Y4~0 Z1 Z2 Z3 Z4 (*1);
  F1-F3@1;
  [F1-F3@0];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4] (i1-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4;
  MODEL G2:
  F1*; F2*; F3*;
  [F1*]; [F2*]; [F3*];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4] (i1-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4;
  OUTPUT:
