INPUT INSTRUCTIONS

  TITLE:
  MG invariance - Latent means [partial strong: Z2]
  DATA:
  FILE = "Ch27-Data1.dat";
  VARIABLE:
  NAMES ARE X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4 GROUP;
  USEVARIABLES ARE X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4;
  GROUPING IS GROUP (1 = G1 2 = G2);
  ANALYSIS:
  ESTIMATOR IS MLR;
  ROTATION=TARGET(OBLIQUE);
  ITERATIONS = 10000;
  MODEL:
  F1 BY X1 X2 X3 X4 Y1~0 Y2~0 Y3~0 Y4~0 Z1~0 Z2~0 Z3~0 Z4~0 (*1);
  F2 BY X1~0 X2~0 X3~0 X4~0 Y1 Y2 Y3 Y4 Z1~0 Z2~0 Z3~0 Z4~0 (*1);
  F3 BY X1~0 X2~0 X3~0 X4~0 Y1~0 Y2~0 Y3~0 Y4~0 Z1 Z2 Z3 Z4 (*1);
  F1-F3@1;
  F1 WITH F2 (cov1);
  F1 WITH F3 (cov2);
  F2 WITH F3 (cov3);
  [F1-F3@0];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1] (i1-i9);
  [Z2*];
  [Z3 Z4] (i11-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4 (u1-u12);
  MODEL G2:
  F1-F3@1;
  F1 WITH F2 (cov1);
  F1 WITH F3 (cov2);
  F2 WITH F3 (cov3);
  [F1-F3@0];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1] (i1-i9);
  [Z2*];
  [Z3 Z4] (i11-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4 (u1-u12);
  OUTPUT:
  SAMPSTAT STANDARDIZED MODINDICES CINTERVAL RESIDUAL SVALUES TECH1 TECH3 TECH4;



