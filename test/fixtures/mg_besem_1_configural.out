INPUT INSTRUCTIONS

  TITLE:
  MG invariance (bifactor-ESEM) - Configural
  DATA:
  FILE = "data.dat";
  VARIABLE:
  NAMES ARE duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1
    sos2_t1 sos3_t1 sos4_t1 duy1_t2 duy2_t2 duy3_t2 duy4_t2 psi1_t2 psi2_t2 psi3_t2
    psi4_t2 sos1_t2 sos2_t2 sos3_t2 sos4_t2 okul;
  USEVARIABLES ARE duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1
    sos1_t1 sos2_t1 sos3_t1 sos4_t1;
  MISSING ARE ALL (999);
  GROUPING IS okul (1 = okulA 2 = okulB);
  ANALYSIS:
  ESTIMATOR IS MLR;
  ROTATION=TARGET(ORTHOGONAL);
  ITERATIONS = 100000;
  MODEL:
  G BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1 sos2_t1
    sos3_t1 sos4_t1 (*1);
  F1 BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1~0 psi2_t1~0 psi3_t1~0 psi4_t1~0
    sos1_t1~0 sos2_t1~0 sos3_t1~0 sos4_t1~0 (*1);
  F2 BY duy1_t1~0 duy2_t1~0 duy3_t1~0 duy4_t1~0 psi1_t1 psi2_t1 psi3_t1 psi4_t1
    sos1_t1~0 sos2_t1~0 sos3_t1~0 sos4_t1~0 (*1);
  F3 BY duy1_t1~0 duy2_t1~0 duy3_t1~0 duy4_t1~0 psi1_t1~0 psi2_t1~0 psi3_t1~0 psi4_t1~0
    sos1_t1 sos2_t1 sos3_t1 sos4_t1 (*1);
  G@1; F1-F3@1;
  [G@0]; [F1-F3@0];
  [duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1 sos2_t1
    sos3_t1 sos4_t1];
  duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1 sos2_t1
    sos3_t1 sos4_t1;
  MODEL okulB:
  G BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1 psi2_t1 psi3_t1 psi4_t1 sos1_t1 sos2_t1
    sos3_t1 sos4_t1 (*1);
  F1 BY duy1_t1 duy2_t1 duy3_t1 duy4_t1 psi1_t1~0 psi2_t1~0 psi3_t1~0 psi4_t1~0
    sos1_t1~0 sos2_t1~0 sos3_t1~0 sos4_t1~0 (*1);
  F2 BY duy1_t1~0 duy2_t1~0 duy3_t1~0 duy4_t1~0 psi1_t1 psi2_t1 psi3_t1 psi4_t1
    sos1_t1~0 sos2_t1~0 sos3_t1~0 sos4_t1~0 (*1);
  F3 BY duy1_t1~0 duy2_t1~0 duy3_t1~0 duy4_t1~0 psi1_t1~0 psi2_t1~0 psi3_t1~0 psi4_t1~0
    sos1_t1 sos2_t1 sos3_t1 sos4_t1 (*1);
  G@1; F1-F3@1;
