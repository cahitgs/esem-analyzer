  F1-F3@1;
  [F1-F3@0];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1] (i1-i9);
  [Z2*];
  [Z3 Z4] (i11-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4;
  MODEL G2:
  F1*; F2*; F3*;
  [F1*]; [F2*]; [F3*];
  [X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1] (i1-i9);
  [Z2*];
  [Z3 Z4] (i11-i12);
  X1 X2 X3 X4 Y1 Y2 Y3 Y4 Z1 Z2 Z3 Z4;
